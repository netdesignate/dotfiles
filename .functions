# Push a single static HTML file to jaxbeachtech.com webroot
# Usage: jbt-deploy cpu-performance-2025.html
jbt-deploy() {
  rsync -avz --progress \
    "/srv/storage/DRM/dev/jaxbeachtech.com/${1}" \
    "donmc@moruya:/var/www/jaxbeachtech.com/${1}"
}

newalias() {
  local name="$1"
  local cmd="$2"
  local dotfiles_dir="$HOME/dotfiles"
  local alias_file="$HOME/.bash_aliases"

  if [[ -z "$name" || -z "$cmd" ]]; then
    echo "Usage: newalias <name> '<command>'"
    return 1
  fi

  # Resolve whether ~/.bash_aliases is a symlink into the repo
  local target_file repo_file
  if [[ -L "$alias_file" ]]; then
    target_file="$(readlink -f "$alias_file")"
  else
    target_file="$alias_file"
  fi
  repo_file="$dotfiles_dir/.bash_aliases"

  # If alias already exists, remove the old line first (overwrite behavior)
  if grep -q "^alias $name=" "$target_file" 2>/dev/null; then
    echo "Alias '$name' already exists — overwriting."
    sed -i "/^alias $name=/d" "$target_file"
    if [[ "$target_file" != "$repo_file" && -f "$repo_file" ]]; then
      sed -i "/^alias $name=/d" "$repo_file"
    fi
  fi

  # 1. Activate immediately (unalias first in case shell has old one cached)
  unalias "$name" 2>/dev/null
  alias "$name"="$cmd"

  # 2. Append the new/updated version
  echo "alias $name='$cmd'" >> "$target_file"

  # 3. Mirror to repo file if it's a separate path
  if [[ "$target_file" != "$repo_file" ]]; then
    echo "alias $name='$cmd'" >> "$repo_file"
  fi

  # 4. Commit and push, with clean success/failure reporting
  local git_ok=1
  (
    cd "$dotfiles_dir" || exit 1

    git add .bash_aliases

    # Nothing to commit is not a failure - just means repo file was already up to date
    if git diff --cached --quiet; then
      echo "Nothing new to commit (repo copy already up to date)."
    else
      if ! git commit -m "Update alias: $name"; then
        echo "WARNING: git commit failed."
        exit 1
      fi
    fi

    if ! git push; then
      echo "WARNING: git push failed — commit is local only."
      exit 1
    fi
  )
  git_ok=$?

  if [[ $git_ok -eq 0 ]]; then
    echo "Alias '$name' set, activated, committed, and pushed."
  else
    echo "Alias '$name' set and activated locally, but commit/push had issues — check 'git status' in $dotfiles_dir."
  fi
}

# Push ALL static html files in the dev folder to live
jbt-deploy-all() {
  rsync -avz --progress --include="*.html" --exclude="*" \
    /srv/storage/DRM/dev/jaxbeachtech.com/ \
    donmc@moruya:/var/www/jaxbeachtech.com/
}

function get.functions() {
  if [ -f ~/.functions ]; then
      cp ~/.functions ~/.functions.backup
      cd ~
      wget -O ~/.functions https://raw.githubusercontent.com/netdesignate/dotfiles/master/.functions
      . ~/.functions
  fi
}

function get.aliases() {
  if [ -f ~/.bash_aliases ]; then
    cp ~/.bash_aliases ~/.bash_aliases.backup
    cd ~
    wget -O ~/.bash_aliases https://raw.githubusercontent.com/netdesignate/dotfiles/master/.bash_aliases
    source ~/.bash_aliases
  fi
}

function myip(){ dig TXT +short o-o.myaddr.l.google.com @ns1.google.com | sed 's/"//g'; }
function aptmods(){ apt list --installed | grep $1 | cut -d '/' -f1; }

# drupal updates follow
# =====================
function upd-ce() {
    if [ "$(whoami)" != "donmc" ]; then
        echo "Script must be run as user: username"
        return 255
    else
        cd /var/www/cityethics.org
        printf "Current Working Directory is: $(pwd)\nBeginning Composer update now...\nRunning \"composer.2.7.6 update \"drupal/core-*\" --with-all-dependencies\"\n\n"
        composer.2.7.6 update "drupal/*" --with-all-dependencies
    fi
}
export -f upd-ce
export -f get.functions
export -f get.aliases
#==================
urldecode() { : "${*//+/ }"; echo -e "${_//%/\\x}"; }
# x="http%3A%2F%2Fstackoverflow.com%2Fsearch%3Fq%3Durldecode%2Bbash"
